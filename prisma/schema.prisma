// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Dosen — Admin/Dosen yang dapat login ke sistem
// ─────────────────────────────────────────────
model Dosen {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(DOSEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kelas     Kelas[]

  @@map("dosens")
}

enum Role {
  ADMIN
  DOSEN
}

// ─────────────────────────────────────────────
// Mahasiswa — Data mahasiswa yang dikelola
// ─────────────────────────────────────────────
model Mahasiswa {
  id         String           @id @default(cuid())
  nim        String           @unique
  name       String
  email      String?          @unique
  password   String           @default("")
  jurusan    String
  semester   Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  attendances     Attendance[]
  kelasMahasiswas KelasMahasiswa[]

  @@map("mahasiswas")
}

// ─────────────────────────────────────────────
// Kelas — Mata Kuliah / Kelas yang diampu Dosen
// ─────────────────────────────────────────────
model Kelas {
  id          String           @id @default(cuid())
  kode        String           @unique
  nama        String
  deskripsi   String?
  dosenId     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  dosen       Dosen            @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  jadwals     JadwalKelas[]
  mahasiswas  KelasMahasiswa[]
  attendances Attendance[]

  @@map("kelas")
}

// ─────────────────────────────────────────────
// JadwalKelas — Jadwal perkuliahan per kelas
// ─────────────────────────────────────────────
model JadwalKelas {
  id         String   @id @default(cuid())
  kelasId    String
  hari       Hari
  jamMulai   String   // format "08:00"
  jamSelesai String   // format "10:30"
  ruangan    String?  // contoh: "Lab Komputer 1", "Gedung A 302"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kelas      Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("jadwal_kelas")
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

// ─────────────────────────────────────────────
// KelasMahasiswa — Mahasiswa yang terdaftar di kelas (Enrollment)
// ─────────────────────────────────────────────
model KelasMahasiswa {
  id          String    @id @default(cuid())
  kelasId     String
  mahasiswaId String
  enrolledAt  DateTime  @default(now())

  kelas       Kelas     @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)

  @@unique([kelasId, mahasiswaId])
  @@map("kelas_mahasiswa")
}

// ─────────────────────────────────────────────
// Attendance — Log kehadiran harian & per kelas
// ─────────────────────────────────────────────
model Attendance {
  id              String           @id @default(cuid())
  mahasiswaId     String
  kelasId         String?
  date            DateTime         @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus @default(ABSENT)
  pertemuanKe     Int?
  notes           String?
  photo           String?          @db.MediumText
  latitude        Float?
  longitude       Float?
  distance        Float?
  isLocationValid Boolean          @default(false)
  aiVerification  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  mahasiswa       Mahasiswa        @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  kelas           Kelas?           @relation(fields: [kelasId], references: [id], onDelete: SetNull)

  @@index([mahasiswaId, date])
  @@index([kelasId, date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  IZIN
  SAKIT
}

// ─────────────────────────────────────────────
// AiReport — Cache hasil analisis Gemini AI
// ─────────────────────────────────────────────
model AiReport {
  id          String   @id @default(cuid())
  reportType  String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  prompt      String
  result      Json
  generatedAt DateTime @default(now())

  @@map("ai_reports")
}
