# ==============================================================================
# SAMA Backend Environment Variables Template (.env.example)
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN PERNAH commit file .env asli ke Git repository!
# ==============================================================================

# Prisma Database URL
DATABASE_URL="mysql://root:@localhost:3306/sama_db"

# Express Server Port
PORT=3001

# JWT Authentication Secrets
# Ganti dengan secret acak yang kuat dan aman untuk production!
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Configuration
# Dapatkan API Key Anda dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Geofencing Koordinat Kampus
# Koordinat lokasi kampus untuk validasi absensi mahasiswa
CAMPUS_LATITUDE=-7.2575
CAMPUS_LONGITUDE=112.7521
CAMPUS_MAX_RADIUS_METERS=100
